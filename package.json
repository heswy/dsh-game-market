{
  "name": "dsh-game-market",
  "version": "1.2.2",
  "description": "Game market and runtime for DeepSeek Harness — play small games while the Agent works.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "packages/host/**",
    "packages/shared/**",
    "packages/runtime/**",
    "packages/sdk/**",
    "scripts/cli/**",
    "templates/**",
    "docs/developer*.md",
    "games/**",
    "registry/**",
    "platform-updates/release.json",
    "README.md",
    "scripts/registry/**",
    "scripts/release/**",
    "skills/**",
    "docs/community*.md",
    "THIRD-PARTY-NOTICES.md"
  ],
  "bin": {
    "dsh-game": "./scripts/cli/dsh-game.mjs",
    "create-dsh-game": "./scripts/cli/create-dsh-game.mjs"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/build-client.mjs",
    "build:snake": "node scripts/build-snake.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test",
    "dev:enable": "node scripts/dev-enable.mjs",
    "dev:disable": "node scripts/dev-disable.mjs",
    "verify": "node scripts/build.mjs && node scripts/check.mjs && node --test",
    "registry:init": "node scripts/registry/init-content-repo.mjs",
    "registry:generate": "node scripts/registry/generate-catalog.mjs",
    "registry:validate": "node scripts/registry/validate-catalog.mjs",
    "registry:prepare": "node scripts/registry/prepare.mjs",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:promote": "node scripts/release/promote.mjs",
    "release:verify": "node scripts/release/verify.mjs",
    "skill:pack": "node scripts/registry/pack-skill.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "dependencies": {
    "yauzl": "3.4.0"
  }
}
