{
  "manifestVersion": 1,
  "id": "react-demo",
  "name": "React Star Catcher",
  "version": "1.0.0",
  "author": {
    "name": "DSH Game Templates"
  },
  "description": "A Vite + React template for the DSH Game Market. Game state lives in refs so React never re-renders per frame.",
  "categories": [
    "arcade"
  ],
  "capabilities": [
    "storage",
    "score"
  ],
  "sdkVersion": "^1.0.0",
  "runtimeVersion": "^1.0.0",
  "preferredTheme": "game-defined",
  "viewport": {
    "width": 960,
    "height": 540,
    "fit": "contain"
  },
  "score": {
    "direction": "higher-better",
    "min": 0,
    "max": 1000000,
    "integer": true
  },
  "save": {
    "schemaVersion": 1
  }
}
