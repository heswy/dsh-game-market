{
  "manifestVersion": 1,
  "id": "vanilla-demo",
  "name": "Vanilla Demo",
  "version": "1.0.0",
  "author": {
    "name": "DSH Game Templates"
  },
  "description": "Catch falling stars with your basket. A tiny canvas game that demonstrates the full Game SDK v1 lifecycle.",
  "categories": [
    "arcade",
    "action"
  ],
  "capabilities": [
    "storage",
    "score"
  ],
  "sdkVersion": "^1.0.0",
  "runtimeVersion": "^1.0.0",
  "preferredTheme": "game-defined",
  "viewport": {
    "width": 960,
    "height": 540,
    "fit": "contain"
  },
  "score": {
    "direction": "higher-better",
    "min": 0,
    "max": 1000000,
    "integer": true
  },
  "save": {
    "schemaVersion": 1
  }
}
