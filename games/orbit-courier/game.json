{
  "manifestVersion": 1,
  "id": "orbit-courier",
  "name": "轨道信使",
  "version": "1.0.0",
  "author": { "name": "DSH Game Market" },
  "description": "轨道信使：在环行星的三条轨道间穿梭，收取货舱、穿过站门交付，躲避碎岩。一局约 120 秒，分数、最高分与进度自动保存。",
  "categories": ["arcade"],
  "tags": ["orbit", "reflex", "keyboard", "short-run"],
  "capabilities": ["storage", "score"],
  "sdkVersion": "^1.0.0",
  "runtimeVersion": "^1.0.0",
  "preferredTheme": "game-defined",
  "viewport": { "width": 720, "height": 1280, "fit": "contain" },
  "score": { "direction": "higher-better", "min": 0, "max": 1000000000, "integer": true },
  "save": { "schemaVersion": 1 },
  "license": "MIT"
}
