{
  "manifestVersion": 1,
  "id": "jump",
  "name": "Jump",
  "version": "1.0.0",
  "author": { "name": "DSH" },
  "description": "纵向平台跳跃：自动弹跳，踩上移动、易碎与弹簧平台，向云端挑战更高分数。",
  "categories": ["arcade"],
  "capabilities": ["storage", "score"],
  "sdkVersion": "^1.0.0",
  "runtimeVersion": "^1.0.0",
  "tags": ["jump", "arcade", "endless", "keyboard"],
  "preferredTheme": "game-defined",
  "viewport": { "width": 540, "height": 960, "fit": "contain" },
  "score": { "direction": "higher-better", "min": 0, "max": 1000000, "integer": true },
  "save": { "schemaVersion": 1 }
}
