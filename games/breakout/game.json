{
  "manifestVersion": 1,
  "id": "breakout",
  "name": "Breakout",
  "version": "1.0.0",
  "author": { "name": "DSH Game Market" },
  "description": "经典打砖块：移动挡板反弹球，击碎普通与坚硬砖块，闯过 5 个关卡。鼠标或键盘都能玩，支持暂停、自动保存与 Continue。",
  "categories": ["arcade"],
  "tags": ["arcade", "breakout", "keyboard", "mouse", "short-run"],
  "capabilities": ["storage", "score"],
  "sdkVersion": "^1.0.0",
  "runtimeVersion": "^1.0.0",
  "preferredTheme": "game-defined",
  "viewport": { "width": 960, "height": 540, "fit": "contain" },
  "score": { "direction": "higher-better", "min": 0, "max": 10000000, "integer": true },
  "save": { "schemaVersion": 1 },
  "license": "MIT"
}
